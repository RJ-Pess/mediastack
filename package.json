{
  "name": "cais",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "pnpm --filter @cais/server dev",
    "dev:web": "pnpm --filter @cais/web dev",
    "build": "pnpm -r build",
