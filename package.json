{
  "name": "mediastack",
  "private": true,
  "license": "MIT",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": "\u003e\u003d22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@mediastack/web",
    "dev:server": "npm run dev --workspace=@mediastack/server",
    "dev:web": "npm run dev --workspace=@mediastack/web",
    "build": "npm run build --workspace=@mediastack/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . \u0026\u0026 prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:integration": "scripts/integration.sh",
    "test:e2e": "scripts/e2e.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
