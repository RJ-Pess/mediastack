# Copia para `.env` (na mesma pasta que o docker-compose.yml) e ajusta.
# Copy to `.env` (next to docker-compose.yml) and adjust.

# --- Permissões / Permissions ---
# Utilizador e grupo dono dos ficheiros (corre `id` no host). / Owner of the files (run `id`).
PUID=1000
PGID=1000
TZ=UTC
UMASK=002

# --- Caminhos no host / Host paths ---
# Raiz de dados (OBRIGATÓRIO). Tem de ser um único volume que contenha torrents e bibliotecas,
# para haver hardlinks. Ex.: /srv/media  (CasaOS: /DATA/Media)
# Data root (REQUIRED). Must be a single filesystem holding downloads and libraries (hardlinks).
DATA_ROOT=
# Onde ficam as configs de cada serviço. Ex.: /srv/cais/config  (CasaOS: /DATA/AppData/cais)
# Where each service keeps its config.
CONFIG_ROOT=./config

# --- Imagem do Cais / Cais image ---
# Constrói localmente com `docker build -t cais:local .` ou usa uma tag publicada (fixa a versão).
# Build locally or pin a published tag, e.g. ghcr.io/<owner>/cais:1.0.0
CAIS_IMAGE=cais:local

# --- Portas publicadas no host / Published host ports ---
# Só o Cais e a porta de torrents. Os outros serviços ficam na rede interna.
# Only Cais and the torrent port are published; the other services stay on the internal network.
CAIS_PORT=8088
TORRENT_PORT=6881
